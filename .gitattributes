# Hugging Face rejects plain-git files over 10 MB. Nothing here is that big today
# (largest is artifacts/portfolio.json, ~0.7 MB), but model and binary formats go
# through Git LFS so a future larger model does not break a push.
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.ubj filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
